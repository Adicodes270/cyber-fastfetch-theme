{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/cyber_logo.txt",
    "color": {
      "1": "#38bdf8", // Electric cyan
      "2": "#818cf8"  // Soft neon violet
    },
    "padding": {
      "top": 1,
      "left": 2,
      "right": 4
    }
  },
  "display": {
    "separator": "  \u001b[38;2;148;163;184m│\u001b[0m  "
  },
  "modules": [
    {
      "type": "title",
      "format": "\u001b[1;38;2;56;189;248m{user-name}\u001b[0m \u001b[38;2;129;140;248m@\u001b[0m \u001b[1;38;2;52;211;153m{host-name}\u001b[0m"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;51;65;85m────────────────────────────────────────\u001b[0m"
    },

    // --- SYSTEM SECTION ---
    {
      "type": "custom",
      "format": "\u001b[1;38;2;56;189;248m󰍹  SYSTEM\u001b[0m"
    },
    {
      "type": "os",
      "key": "  󰣇 OS",
      "keyColor": "38;2;56;189;248"
    },
    {
      "type": "kernel",
      "key": "  󰒋 Kernel",
      "keyColor": "38;2;56;189;248"
    },
    {
      "type": "uptime",
      "key": "  󱫐 Uptime",
      "keyColor": "38;2;56;189;248"
    },
    {
      "type": "packages",
      "key": "  󰏖 Packages",
      "keyColor": "38;2;56;189;248"
    },
    "break",

    // --- DESKTOP SECTION ---
    {
      "type": "custom",
      "format": "\u001b[1;38;2;129;140;248m󱂬  ENVIRONMENT\u001b[0m"
    },
    {
      "type": "wm",
      "key": "  󱂬 WM",
      "keyColor": "38;2;129;140;248"
    },
    {
      "type": "terminal",
      "key": "  󰞷 Terminal",
      "keyColor": "38;2;129;140;248"
    },
    {
      "type": "shell",
      "key": "  󱆃 Shell",
      "keyColor": "38;2;129;140;248"
    },
    {
      "type": "terminalfont",
      "key": "  󰛖 Font",
      "keyColor": "38;2;129;140;248"
    },
    "break",

    // --- HARDWARE SECTION ---
    {
      "type": "custom",
      "format": "\u001b[1;38;2;52;211;153m󰘚  HARDWARE\u001b[0m"
    },
    {
      "type": "cpu",
      "key": "  󰻠 CPU",
      "keyColor": "38;2;52;211;153",
      "showPeCoreCount": false
    },
    {
      "type": "gpu",
      "key": "  󰢮 GPU",
      "keyColor": "38;2;52;211;153"
    },
	
    {
      "type": "board",
      "key": "  󱤓 Motherboard",
      "keyColor": "38;2;52;211;153"
    },	
	
 
    {
      "type": "memory",
      "key": "  󰍛 Memory",
      "keyColor": "38;2;52;211;153"
    },
    {
      "type": "disk",
      "key": "  󰋊 Storage",
      "keyColor": "38;2;52;211;153"
    },
    {
      "type": "display",
      "key": "  󰍹 Monitor",
      "keyColor": "38;2;52;211;153"
      
    },

    {
      "type": "custom",
      "key": "  󰌌 Keyboard",
      "keyColor": "38;2;52;211;153",
      "format": "Ant Esports KM540 Membrane Keyboard"
    },
    {
      "type": "custom",
      "key": "  󰍽 Mouse",
      "keyColor": "38;2;52;211;153",
      "format": "EvoFox Phantom 2 Gaming Mouse"
    },


    "break",

    // --- COLOR PALETTE STRIP ---
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
